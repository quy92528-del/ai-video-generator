# ============================================================
# AI Video Generator Suite - Environment Variables Template
# Copy this file to .env and fill in your API keys.
# ============================================================

# -------------------------------------------------------
# Hybrid Station 1 - Platform API Keys
# -------------------------------------------------------

# --- Veo (Google) ---
# Primary key + extra keys for multi-key load balancing
VEO_API_KEY=your_veo_api_key_here
VEO_API_KEYS_EXTRA=key2,key3          # Comma-separated additional Veo keys (optional)
VEO_MODEL=veo-3                        # e.g. veo-3, veo-3-fast
VEO_ACCOUNT_TYPE=Veo3_Grok            # Displayed in UI (e.g. "Veo3_Grok")
VEO_EXPIRES_AT=23/05/2027             # Displayed in UI

# --- Grok (xAI) ---
GROK_API_KEY=your_grok_api_key_here
GROK_API_KEYS_EXTRA=key2,key3          # Comma-separated additional Grok keys (optional)
GROK_MODEL=grok-2-vision-1212
GROK_ACCOUNT_TYPE=Grok_Pro
GROK_EXPIRES_AT=31/12/2025

# --- ChatGPT / OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEYS_EXTRA=                 # Optional extra keys
OPENAI_MODEL=gpt-4o

# --- Platform API Priority (comma-separated, tried left-to-right) ---
API_PRIORITY=veo,grok,gemini,chatgpt

# -------------------------------------------------------
# REQUIRED: Google Gemini (script writing + image generation)
# -------------------------------------------------------
# Get your Gemini API key at: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud project for Text-to-Speech + Station 2 GPU VM
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_CLOUD_CREDENTIALS_JSON=path/to/service-account.json
GOOGLE_CLOUD_LOCATION=us-central1

# -------------------------------------------------------
# Hybrid Station 2 - GCP GPU VM
# -------------------------------------------------------
# Set ENABLE_STATION2_GPU=true to allow GPU VM fallback when all APIs fail.
# The VM is ALWAYS shut down after each task (Safe-Off guarantee).
GCP_PROJECT_ID=your_gcp_project_id
GCP_ZONE=us-central1-a
GCP_GPU_INSTANCE_NAME=ai-video-gpu-worker
GCP_SSH_USER=ubuntu
GCP_WORKER_SCRIPT=/opt/ai-video/worker.py
GCP_VM_STARTUP_TIMEOUT=300            # Seconds to wait for VM to be ready
GCP_VM_TASK_TIMEOUT=3600              # Maximum seconds for the GPU task
ENABLE_STATION2_GPU=false             # Set to true to enable GPU fallback

# -------------------------------------------------------
# OPTIONAL: Video Generation (fallback providers)
# -------------------------------------------------------
# Runway Gen-3: https://app.runwayml.com/account/api-keys
RUNWAY_API_KEY=your_runway_api_key_here
RUNWAY_API_VERSION=2024-11-06

# Replicate (Stable Diffusion + Wav2Lip): https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# -------------------------------------------------------
# OPTIONAL: Audio & Voice
# -------------------------------------------------------
# ElevenLabs TTS: https://elevenlabs.io/app/profile/api-key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# -------------------------------------------------------
# OPTIONAL: Avatar Videos
# -------------------------------------------------------
# HeyGen: https://app.heygen.com/settings/api
HEYGEN_API_KEY=your_heygen_api_key_here

# D-ID (alternative avatar service): https://studio.d-id.com/account-settings
DID_API_KEY=your_did_api_key_here

# -------------------------------------------------------
# Task Queue (optional – for distributed processing)
# -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -------------------------------------------------------
# Processing Configuration
# -------------------------------------------------------
MAX_WORKERS=10
BATCH_SIZE=50
REQUEST_TIMEOUT=120
MAX_RETRIES=3
RETRY_DELAY=2.0

# -------------------------------------------------------
# Video Defaults
# -------------------------------------------------------
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_DURATION=80                    # 10 scenes × 8s (Veo default)
DEFAULT_LANGUAGE=vi
DEFAULT_VIDEO_STYLE=cinematic
VIDEO_FPS=30
VIDEO_RESOLUTION=1920x1080

# -------------------------------------------------------
# Budget
# -------------------------------------------------------
# Total budget in USD (Google Cloud $300 free credit)
BUDGET_LIMIT_USD=300.0
COST_ALERT_THRESHOLD=0.8

# -------------------------------------------------------
# Storage
# -------------------------------------------------------
OUTPUT_DIR=output
ASSETS_DIR=assets
CACHE_DIR=.cache
LOG_DIR=output/logs

# -------------------------------------------------------
# Feature Flags
# -------------------------------------------------------
ENABLE_FACE_CONSISTENCY=true
ENABLE_AUDIO_DUCKING=true
ENABLE_COST_TRACKING=true
ENABLE_CACHING=true
DEBUG_MODE=false

# -------------------------------------------------------
# Model Selection
# -------------------------------------------------------
GEMINI_MODEL=gemini-1.5-pro
STABLE_DIFFUSION_MODEL=stability-ai/sdxl:7762fd07cf82c948538e41f63f77d685e02b063e37e496e96eefd46c929f9bdc
WAV2LIP_MODEL=devxpy/cog-wav2lip:8d65e3f4f42985ff6a9e54fd5e48a23dc32a7d0a
