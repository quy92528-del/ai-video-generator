# ============================================================
# AI Video Generator Suite - Environment Variables Template
# Copy this file to .env and fill in your API keys.
# ============================================================

# -------------------------------------------------------
# REQUIRED: Google APIs
# -------------------------------------------------------
# Get your Gemini API key at: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud project for Text-to-Speech
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_CLOUD_CREDENTIALS_JSON=path/to/service-account.json
GOOGLE_CLOUD_LOCATION=us-central1

# -------------------------------------------------------
# OPTIONAL: Video Generation
# -------------------------------------------------------
# Runway Gen-3: https://app.runwayml.com/account/api-keys
RUNWAY_API_KEY=your_runway_api_key_here
RUNWAY_API_VERSION=2024-11-06

# Replicate (Stable Diffusion + Wav2Lip): https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# -------------------------------------------------------
# OPTIONAL: Audio & Voice
# -------------------------------------------------------
# ElevenLabs TTS: https://elevenlabs.io/app/profile/api-key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# -------------------------------------------------------
# OPTIONAL: Avatar Videos
# -------------------------------------------------------
# HeyGen: https://app.heygen.com/settings/api
HEYGEN_API_KEY=your_heygen_api_key_here

# D-ID (alternative avatar service): https://studio.d-id.com/account-settings
DID_API_KEY=your_did_api_key_here

# -------------------------------------------------------
# FUTURE: Grok API (not yet publicly available)
# -------------------------------------------------------
GROK_API_KEY=your_grok_api_key_when_available

# -------------------------------------------------------
# Task Queue (optional – for distributed processing)
# -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -------------------------------------------------------
# Processing Configuration
# -------------------------------------------------------
MAX_WORKERS=10
BATCH_SIZE=50
REQUEST_TIMEOUT=120
MAX_RETRIES=3
RETRY_DELAY=2.0

# -------------------------------------------------------
# Video Defaults
# -------------------------------------------------------
DEFAULT_ASPECT_RATIO=9:16
DEFAULT_DURATION=30
DEFAULT_LANGUAGE=vi
DEFAULT_VIDEO_STYLE=cinematic
VIDEO_FPS=30
VIDEO_RESOLUTION=1080x1920

# -------------------------------------------------------
# Budget
# -------------------------------------------------------
# Total budget in USD (Google Cloud $300 credit)
BUDGET_LIMIT_USD=300.0
COST_ALERT_THRESHOLD=0.8

# -------------------------------------------------------
# Storage
# -------------------------------------------------------
OUTPUT_DIR=output
ASSETS_DIR=assets
CACHE_DIR=.cache
LOG_DIR=output/logs

# -------------------------------------------------------
# Feature Flags
# -------------------------------------------------------
ENABLE_FACE_CONSISTENCY=true
ENABLE_AUDIO_DUCKING=true
ENABLE_COST_TRACKING=true
ENABLE_CACHING=true
DEBUG_MODE=false

# -------------------------------------------------------
# Model Selection
# -------------------------------------------------------
GEMINI_MODEL=gemini-1.5-pro
STABLE_DIFFUSION_MODEL=stability-ai/sdxl:39ed52f2319f9f4ab7a967071f5720dbfb4cd6b079cf5e4e38c5cbde04e7ef45
WAV2LIP_MODEL=devxpy/cog-wav2lip:8d65e3f4f4298519a9d84e2f40c4ee69f3c9a6c9db7b88c93c9db7b88c93c9d
