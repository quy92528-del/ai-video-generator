# AI Video Generator - Environment Variables Template
# Copy this file to .env and fill in your actual API keys.
# Never commit .env to version control.

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Google Veo API key for video generation
VEO_API_KEY=your_veo_api_key_here

# (Optional) Grok API key (https://console.x.ai/)
GROK_API_KEY=your_grok_api_key_here

# --- Batch processing settings ---
# Number of videos to generate per run
BATCH_SIZE=10

# Output directory for generated videos
OUTPUT_DIR=output

# Path to input CSV/JSON file containing video prompts
INPUT_FILE=prompts.csv

# Gemini model to use for prompt generation
GEMINI_MODEL=gemini-1.5-pro
